PORT=3000
HOST=0.0.0.0
NODE_ENV=development
NODE_VERSION=22.14.0
DB_PATH=./data/centinela.db
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_USER=admin
ADMIN_PASSWORD=change-this-local-password
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PUBLIC_DASHBOARD_URL=http://localhost:3000
DEMO_PAYMENTS=false
ALLOW_LEGACY_BASIC=false

# Persistencia de la base en GitHub (plan free de Render usa disco efimero).
# Crea un repositorio PRIVADO y un PAT con permiso "Contents" (read/write).
DB_BACKUP_REPO=tu-usuario/centinela-db-backup
DB_BACKUP_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DB_BACKUP_PATH=centinela.db.gz
DB_BACKUP_BRANCH=main
DB_BACKUP_INTERVAL_MIN=30
