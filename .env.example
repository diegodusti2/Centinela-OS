PORT=3000
HOST=0.0.0.0
NODE_ENV=development
NODE_VERSION=22.14.0
# Base de datos PostgreSQL (Neon). Requerida en produccion.
DATABASE_URL=postgresql://usuario:clave@host/database
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_USER=admin
ADMIN_PASSWORD=change-this-local-password
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PUBLIC_DASHBOARD_URL=http://localhost:3000
DEMO_PAYMENTS=false
ALLOW_LEGACY_BASIC=false
